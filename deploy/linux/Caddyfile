ENROLLMENT_HOST {
	encode zstd gzip

	@enrollment path /v1/enroll /v1/healthz
	handle @enrollment {
		reverse_proxy 127.0.0.1:8443
	}

	@root path /
	handle @root {
		header Content-Type application/json
		respond `{"status":"ok","service":"LinkForge enrollment","dashboard":"http://127.0.0.1:9090/"}`
	}

	handle {
		respond 404
	}
}
