[Unit]
Description=LinkForge relay forwarding and NAT
After=network-online.target docker.service
Wants=network-online.target
Before=linkforge-server.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/linkforge/firewall.env
ExecStart=/usr/local/libexec/linkforge-firewall apply
ExecStop=/usr/local/libexec/linkforge-firewall remove
RemainAfterExit=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
